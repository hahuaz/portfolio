{
  "name": "cdk-starter",
  "version": "0.1.0",
  "bin": {
    "cdk-starter": "bin/cdk-starter.js"
  },
  "scripts": {
    "tsc:build": "tsc",
    "tsc:watch": "tsc -w",
    "tsc:check": "tsc --project tsconfig.json --pretty --noEmit",
    "lint": "eslint . --ext js,jsx,ts,tsx --fix",
    "cdk:list": "npx cdk ls",
    "cdk:deploy": "npx cdk deploy --profile hahuaz-root",
    "cdk:watch": "npx cdk watch PROD-hahuaz --hotswap-fallback --logs --profile hahuaz-root"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.41.0",
    "aws-sdk": "^2.1692.0",
    "axios": "^1.4.0",
    "constructs": "^10.1.98",
    "dotenv": "^16.3.1",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/aws-lambda": "^8.10.93",
    "@types/node": "^17.0.23",
    "@typescript-eslint/utils": "^8.25.0",
    "aws-lambda": "^1.0.7",
    "esbuild": "^0.14.36",
    "eslint": "^9.21.0",
    "globals": "^16.0.0",
    "jit": "^0.1.1",
    "jiti": "^2.4.2",
    "ts-node": "^10.7.0",
    "typescript": "^4.9.5",
    "typescript-eslint": "^8.25.0"
  }
}